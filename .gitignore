# ========================================================
# BloodBridge .gitignore
# ========================================================

# Sensitive environment configuration
.env
.env.local
.env.*.local
*.env
!/.env.example

# Maven build outputs
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# IDE & Editor files
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs & temporary runtime files
*.log
logs/
*.pid
cookies*.txt
scratch/

# Local database file storage
data/
*.h2.db
*.trace.db

.env
*.env
application-local.properties
application-prod.properties
