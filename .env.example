# ========================================================
# BloodBridge Environment Configuration Template
# Instructions:
#   1. Copy this file to .env:
#      cp .env.example .env
#   2. Replace placeholder values with your local settings.
# ========================================================

# MySQL / TiDB Database Configuration
# For Local MySQL:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blood_bridge
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
DB_URL=jdbc:mysql://localhost:3306/blood_bridge

# For TiDB Cloud (Production on Render):
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=blood_bridge
# DB_USERNAME=your_tidb_user.root
# DB_PASSWORD=your_tidb_password
# DB_URL=jdbc:mysql://gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/blood_bridge?useSSL=true&sslMode=VERIFY_IDENTITY

# Application Server Port
SERVER_PORT=8080

# Active Spring Profile (local: live MySQL / TiDB, dev: H2 file database)
SPRING_PROFILES_ACTIVE=local

# JPA / Hibernate SQL Logging (true / false)
JPA_SHOW_SQL=false

# Twilio Comms Email Configuration
TWILIO_EMAIL_ENABLED=true
TWILIO_EMAIL_API_URL=https://comms.twilio.com/v1/Emails
TWILIO_API_KEY_SID=your_twilio_api_key_or_account_sid_here
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret_or_auth_token_here
TWILIO_FROM_ADDRESS=your_verified_sender_email@example.com
TWILIO_FROM_NAME=BloodBridge


