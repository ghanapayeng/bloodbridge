# ========================================================
# BloodBridge Environment Configuration Template
# Instructions:
#   1. Copy this file to .env for local testing:
#      cp .env.example .env
#   2. In Vercel, add these under Project Settings -> Environment Variables.
#      Never commit real credentials to git.
# ========================================================

# MySQL / TiDB Database Configuration
# TiDB Cloud Serverless (Production Recommended):
# DB_URL=jdbc:mysql://gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/blood_bridge?useSSL=true&sslMode=VERIFY_IDENTITY
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blood_bridge
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
DB_URL=jdbc:mysql://localhost:3306/blood_bridge

# Application Port (Vercel Container Runtime sets PORT automatically)
PORT=8080
SERVER_PORT=8080

# Active Spring Profile (local: live MySQL / TiDB, test: H2 database)
SPRING_PROFILES_ACTIVE=local

# JPA / Hibernate SQL Logging (true / false)
JPA_SHOW_SQL=false

# Gmail SMTP Email Configuration (JavaMailSender)
# Requires Google Account 2-Step Verification and a 16-character App Password.
# Generate App Password: https://myaccount.google.com/apppasswords
GMAIL_USERNAME=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Vercel Gateway Target (Only used if proxy gateway fallback is triggered)
# In Vercel Services, internal routing is handled automatically.
# BACKEND_URL=https://your-backend-service.vercel.app
