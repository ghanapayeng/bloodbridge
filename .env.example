# ========================================================
# BloodBridge Environment Configuration Template
# Instructions:
#   1. Copy this file to .env:
#      cp .env.example .env
#   2. Replace placeholder values with your local settings.
# ========================================================

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blood_bridge
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
DB_URL=jdbc:mysql://localhost:3306/blood_bridge

# Application Server Port
SERVER_PORT=8080

# Active Spring Profile (local: live MySQL, dev: H2 file database)
SPRING_PROFILES_ACTIVE=local

# JPA / Hibernate SQL Logging (true / false)
JPA_SHOW_SQL=false
