# ========================================================
# BloodBridge Environment Configuration Template
# Instructions:
#   1. Copy this file to .env:
#      cp .env.example .env
#   2. Replace placeholder values with your local settings.
# ========================================================

# MySQL / TiDB Database Configuration
# For Local MySQL:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blood_bridge
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
DB_URL=jdbc:mysql://localhost:3306/blood_bridge

# For TiDB Cloud (Production):
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=blood_bridge
# DB_USERNAME=your_tidb_user.root
# DB_PASSWORD=your_tidb_password
# DB_URL=jdbc:mysql://gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/blood_bridge?useSSL=true&sslMode=VERIFY_IDENTITY

# Application Server Port
SERVER_PORT=8080

# Active Spring Profile (local: live MySQL / TiDB, dev: H2 file database)
SPRING_PROFILES_ACTIVE=local

# JPA / Hibernate SQL Logging (true / false)
JPA_SHOW_SQL=false

# Resend Email API Configuration
# Get your API key from https://resend.com/api-keys with "Sending access"
RESEND_API_KEY=re_your_api_key_here
# Sender email address
# Testing mode allows: onboarding@resend.dev (delivers only to your Resend account email)
# Production requires a verified domain in Resend: e.g. BloodBridge <noreply@yourdomain.com>
RESEND_FROM=onboarding@resend.dev


